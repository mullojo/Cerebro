#!/bin/sh
# Use installed Node or the Node runtime bundled with this Codex environment.
set -eu
cd -- "$(dirname -- "$0")"
if command -v node >/dev/null 2>&1; then
  exec node "$@"
fi
cerebro_node="$HOME/.cache/codex-runtimes/codex-primary-runtime/dependencies/node/bin/node"
if [ -x "$cerebro_node" ]; then
  exec "$cerebro_node" "$@"
fi
printf '%s\n' 'Cerebro needs Node.js 22 or newer. Install Node from https://nodejs.org, then try again.'
exit 1
